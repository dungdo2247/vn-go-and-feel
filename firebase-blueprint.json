{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User profile storing check-ins and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "visitedProvinces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of 63 provinces the traveler has checked in"
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "savedPlan": {
      "title": "Saved Travel Plan",
      "description": "Travel itinerary generated by AI and saved by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "destination": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "string" },
        "companions": { "type": "string" },
        "preferences": { "type": "string" },
        "budget": { "type": "string" },
        "summary": { "type": "string" },
        "itinerary": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "destination", "title"]
    },
    "photoJournal": {
      "title": "Photo Journal",
      "description": "Photo memory story written by AI and shared by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "location": { "type": "string" },
        "mood": { "type": "string" },
        "caption": { "type": "string" },
        "journalText": { "type": "string" },
        "hashtags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "imageUrl": { "type": "string" },
        "date": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "location", "caption", "journalText"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Individual user document containing visited provinces"
    },
    "/users/{userId}/plans/{planId}": {
      "schema": "savedPlan",
      "description": "User saved itineraries"
    },
    "/users/{userId}/journals/{journalId}": {
      "schema": "photoJournal",
      "description": "User photo journals"
    },
    "/publicJournals/{journalId}": {
      "schema": "photoJournal",
      "description": "Public community journals feed"
    }
  }
}
